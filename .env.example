# Supabase Connection URL (Pooler - Transaction mode, Port 6543)
# Used by the application at runtime on Vercel
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase Direct Connection URL (Session / Direct mode, Port 5432)
# Used by Prisma CLI for migrations and schema pushes
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Admin Site Authentication Password
ADMIN_PASSWORD="your_secure_admin_password"
